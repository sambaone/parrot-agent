# ─── Plantilla de variables de entorno ────────────────────────────────────────
# Este archivo SÍ se commitea. Solo nombres y placeholders: NUNCA valores reales.
# Copia a `.env.local` (ignorado por git) para desarrollo local.

# Credencial de modelo para desarrollo local.
# `eve link` normalmente deja aquí un VERCEL_OIDC_TOKEN y no necesitas esta clave.
# En Vercel tampoco se necesita: el deployment usa OIDC vía AI Gateway.
AI_GATEWAY_API_KEY=

# Canal de Slack donde se postea el standup diario (empieza con C...).
# Se obtiene en los detalles del canal en Slack (Fase 7 del setup).
STANDUP_SLACK_CHANNEL_ID=

# Clave del proyecto de Jira a resumir, ej. PROY
JIRA_PROJECT_KEY=

# cloudId del sitio de Atlassian (UUID). Opcional pero muy recomendado: sin él
# el agente lo redescubre en cada sesión, lo que costaba hasta 27 tool calls y
# 22 minutos por standup. Se obtiene llamando a jira__getAccessibleResources una
# vez, o en la URL de admin.atlassian.com del sitio.
JIRA_CLOUD_ID=

# UID del conector de Vercel Connect para el MCP de Atlassian.
# Lo devuelve: vercel connect create mcp.atlassian.com --name jira
# Formato: mcp.atlassian.com/<nombre>
JIRA_CONNECTOR_UID=

# UID del conector de Vercel Connect para Slack.
# Lo devuelve: vercel connect create slack --triggers
# Formato: slack/<nombre>
SLACK_CONNECTOR_UID=

# ID del workspace de Slack (empieza con T).
SLACK_TEAM_ID=

# ID de Slack (empieza con U) de la persona cuya autorización de Atlassian usa
# el standup automático. El conector de Atlassian solo emite tokens de usuario,
# no de aplicación, así que el cron corre bajo este principal para reutilizar el
# grant que esa persona otorgó una vez desde Slack. Ver agent/lib/slack-principal.ts
STANDUP_AS_SLACK_USER_ID=

# Quién puede modificar tickets que ya existen, y con qué cuenta de Jira.
# Pares <slackUserId>:<jiraAccountId> separados por comas; los espacios y saltos
# de línea se ignoran. El slackUserId empieza con U (perfil de la persona en
# Slack → ⋮ → Copiar miembro ID); el jiraAccountId sale de lookupJiraAccountId.
#
# Hace falta porque todas las sesiones escriben en Jira bajo el mismo usuario,
# así que Jira no puede distinguir quién pidió el cambio: la regla "solo
# modificas lo que está asignado a ti" la aplica el agente contra esta tabla.
#
# Falla cerrada: quien no esté aquí puede consultar, crear tickets y comentar,
# pero no modificar los existentes. Sin la variable, nadie modifica nada.
# Formato: SLACK_JIRA_ACCOUNTS=U01ABCDEF:5f8a...,U02GHIJKL:6b2c...
SLACK_JIRA_ACCOUNTS=

# Solo desarrollo local. Ponlo en 1 para que la TUI de `eve dev` actúe con el
# principal de STANDUP_AS_SLACK_USER_ID y así poder probar Jira en local
# (`localDev()` no da un principal de usuario y Jira es user-scoped).
# NUNCA se configura en Vercel. Ver agent/channels/eve.ts
EVE_DEV_AS_STANDUP_USER=
