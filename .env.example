# ─── Plantilla de variables de entorno ────────────────────────────────────────
# Este archivo SÍ se commitea. Solo nombres y placeholders: NUNCA valores reales.
# Copia a `.env.local` (ignorado por git) para desarrollo local.

# Credencial de modelo para desarrollo local.
# `eve link` normalmente deja aquí un VERCEL_OIDC_TOKEN y no necesitas esta clave.
# En Vercel tampoco se necesita: el deployment usa OIDC vía AI Gateway.
AI_GATEWAY_API_KEY=

# Canal de Slack donde se postea el standup diario (empieza con C...).
# Se obtiene en los detalles del canal en Slack (Fase 7 del setup).
STANDUP_SLACK_CHANNEL_ID=

# Clave del proyecto de Jira a resumir, ej. PROY
JIRA_PROJECT_KEY=

# UID del conector de Vercel Connect para el MCP de Atlassian.
# Lo devuelve: vercel connect create mcp.atlassian.com --name jira
# Formato: mcp.atlassian.com/<nombre>
JIRA_CONNECTOR_UID=

# UID del conector de Vercel Connect para Slack.
# Lo devuelve: vercel connect create slack --triggers
# Formato: slack/<nombre>
SLACK_CONNECTOR_UID=
